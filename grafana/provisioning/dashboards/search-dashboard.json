{
  "uid": "motor-busca-main",
  "title": "Motor de Busca — Observabilidade",
  "tags": ["motor-busca"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total de Buscas",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(motorbusca_search_requests_total[1h]))",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Buscas com Resultado",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(motorbusca_search_requests_total{found=\"true\"}[1h]))",
          "legendFormat": "Encontradas"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tempo Médio (ms)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(motorbusca_search_duration_ms_milliseconds_sum) / sum(motorbusca_search_duration_ms_milliseconds_count)",
          "legendFormat": "Média (ms)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Algoritmos Disponíveis",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (algorithm) (motorbusca_search_requests_total))",
          "legendFormat": "Algoritmos"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Buscas por Algoritmo",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (algorithm) (increase(motorbusca_search_requests_total[1h]))",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Tempo Médio por Algoritmo (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (algorithm) (motorbusca_search_duration_ms_milliseconds_sum) / sum by (algorithm) (motorbusca_search_duration_ms_milliseconds_count)",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buscas por Segundo — por Algoritmo",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (algorithm) (rate(motorbusca_search_requests_total[1m]))",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência por Percentil (ms)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(motorbusca_search_duration_ms_milliseconds_bucket[2m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(motorbusca_search_duration_ms_milliseconds_bucket[2m])) by (le))",
          "legendFormat": "p90"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(motorbusca_search_duration_ms_milliseconds_bucket[2m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tamanho Médio dos Documentos (chars)",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(motorbusca_document_size_chars_sum[5m])) / sum(rate(motorbusca_document_size_chars_count[5m]))",
          "legendFormat": "Tamanho médio"
        }
      ]
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Taxa de Sucesso por Algoritmo",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 7 },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (algorithm) (increase(motorbusca_search_requests_total{found=\"true\"}[1h]))",
          "legendFormat": "{{algorithm}} ✓"
        }
      ]
    }
  ]
}
